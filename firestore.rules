rules_version = '2';
// Cada pessoa só enxerga e escreve no próprio espaço (o Correios é a única troca entre contas).
service cloud.firestore {
  match /databases/{database}/documents {
    // Quem usa o Tyba aparece na lista do Correios (só o primeiro nome). Qualquer pessoa logada lê; cada uma escreve só o próprio.
    match /membros/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // Correios: qualquer pessoa logada deixa uma carta na caixa de outra; só a dona da caixa lê e apaga.
    match /correios/{dono}/cartas/{id} {
      allow create: if request.auth != null && request.resource.data.de == request.auth.uid;
      allow read, delete: if request.auth != null && request.auth.uid == dono;
    }
    match /espacos/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{documento=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
