{
  "id": "./",
  "name": "Meu Espaço",
  "short_name": "Meu Espaço",
  "description": "Seu arquivo pessoal: notas, tarefas, imagens, links, livros, músicas e o que mais você quiser guardar.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "./#/inicio",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#eef1f7",
  "theme_color": "#eef1f7",
  "categories": ["productivity", "lifestyle", "utilities"],
  "icons": [
    { "src": "assets/img/pwa/icone-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/img/pwa/icone-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/img/pwa/icone-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/img/pwa/icone.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Nova nota", "short_name": "Nota", "url": "./#/novo/nota", "icons": [{ "src": "assets/img/pwa/icone-192.png", "sizes": "192x192" }] },
    { "name": "Nova tarefa", "short_name": "Tarefa", "url": "./#/novo/tarefa", "icons": [{ "src": "assets/img/pwa/icone-192.png", "sizes": "192x192" }] },
    { "name": "Guardar imagem", "short_name": "Imagem", "url": "./#/novo/imagem", "icons": [{ "src": "assets/img/pwa/icone-192.png", "sizes": "192x192" }] },
    { "name": "Guardar link", "short_name": "Link", "url": "./#/novo/link", "icons": [{ "src": "assets/img/pwa/icone-192.png", "sizes": "192x192" }] },
    { "name": "Modo trabalho", "short_name": "Trabalho", "url": "./#/novo/trabalho", "icons": [{ "src": "assets/img/pwa/icone-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "titulo", "text": "texto", "url": "url" }
  }
}
